  font-size: clamp(2.316rem, 8vw, 4.21rem);
  font-weight: 300;
  line-height: 0.9;
  letter-spacing: 0;
  overflow-wrap: break-word;
}

.t-h2-col {
  font-family: var(--font-display), system-ui, sans-serif;
  font-size: clamp(1.717rem, 4vw, 2.861rem);
  font-weight: 300;
  line-height: 0.95;
  letter-spacing: 0;
  overflow-wrap: break-word;
}

.t-h3 {
  font-family: var(--font-display), system-ui, sans-serif;
  font-size: clamp(1.555rem, 2.2vw, 1.944rem);
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: 0;
  overflow-wrap: break-word;
}

.t-lead {
  font-family: var(--font-sans), system-ui, sans-serif;
  font-size: clamp(1.125rem, 1.6vw, 1.455rem);
  font-weight: 400;
  line-height: 1.45;
  letter-spacing: 0;
}

.t-body {
  font-family: var(--font-sans), system-ui, sans-serif;
  font-size: clamp(1rem, 1.1vw, 1.125rem);
  font-weight: 400;
  line-height: 1.6;
  letter-spacing: 0;
}

.meta {
  font-family: var(--font-sans), system-ui, sans-serif;
  font-size: clamp(0.75rem, 0.9vw, 0.875rem);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.btn-label {
  font-family: var(--font-sans), system-ui, sans-serif;
  font-size: clamp(0.875rem, 1vw, 1rem);
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

/* The measure every running-text block is capped to. */
.measure {
  max-width: var(--measure);
}

/* A dark page still has to pass the axe contrast gate: the ink steps above
   are light-on-dark and the ramp is inverted, not merely re-pointed. */
"

exports[`editorial-serif > matches its snapshot 1`] = `
"/* Generated from design.json by the design stage — do not hand-edit.
   direction: editorial-serif · seed: editorial-serif-fixture
   Every value below is derived from the spec: the scale from scaleRatio
   3.75, the ramp from brandH 318 / brandC 0.06
   (light, mono-hue). design-rules.md §4 owns the eight steps;
   the numbers are editorial-serif's. */

@import "tailwindcss";

:root {
  --brand-h: 318;
  --brand-c: 0.06;

  /* paper: light, mono-hue */
  --paper-50: oklch(0.99 calc(var(--brand-c) * 0.18) var(--brand-h));
  --paper-100: oklch(0.975 calc(var(--brand-c) * 0.207) var(--brand-h));
  --paper-200: oklch(0.95 calc(var(--brand-c) * 0.23399999999999999) var(--brand-h));
  --paper-300: oklch(0.91 calc(var(--brand-c) * 0.261) var(--brand-h));
  --paper-400: oklch(0.86 calc(var(--brand-c) * 0.288) var(--brand-h));
  --paper-500: oklch(0.8 calc(var(--brand-c) * 0.315) var(--brand-h));

  /* ink */
  --ink-900: oklch(0.18 calc(var(--brand-c) * 0.35) var(--brand-h));
  --ink-800: oklch(0.26 calc(var(--brand-c) * 0.3) var(--brand-h));
  --ink-700: oklch(0.36 calc(var(--brand-c) * 0.24999999999999997) var(--brand-h));
  --ink-600: oklch(0.46 calc(var(--brand-c) * 0.19999999999999996) var(--brand-h));
  --ink-400: oklch(0.64 calc(var(--brand-c) * 0.14999999999999997) var(--brand-h));

  --background: var(--paper-100);
  --foreground: var(--ink-900);
  --brand-accent: oklch(0.52 var(--brand-c) var(--brand-h));

  --font-display: var(--font-display-face);
  --font-sans: var(--font-body-face);

  /* shape (§4.2) */
  --radius: 0rem;
  --rule-width: 0px;
  --rule-color: transparent;

  /* grid (§4.2), as tokens so an archetype never branches on the direction
     name. left-flush: a centred language and a left-flush one are the
     same markup with a different anchor. */
  --text-align: left;
  --align-items: flex-start;
  /* How far a secondary column is pushed off the baseline grid. Zero unless
     the direction is asymmetric, which is the only one that offsets. */
  --offset-y: 0rem;

  /* rhythm, from grid.density (editorial) */
  --section-y: 4.5rem;
  --section-y-lg: 6.5rem;
  /* line length < 80ch (design-rules.md §4) */
  --measure: 72ch;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-paper-50: var(--paper-50);
  --color-paper-100: var(--paper-100);
  --color-paper-200: var(--paper-200);
  --color-paper-300: var(--paper-300);
  --color-paper-400: var(--paper-400);
  --color-paper-500: var(--paper-500);
  --color-ink-900: var(--ink-900);
  --color-ink-800: var(--ink-800);
  --color-ink-700: var(--ink-700);
  --color-ink-600: var(--ink-600);
  --color-ink-400: var(--ink-400);
  --color-accent: var(--brand-accent);

  /* The template's own components and globals.css's shadcn mapping are still
     written against brand-*; without these aliases every one of them
     resolves to nothing the moment this file replaces tokens.css. */
  --color-brand-50: var(--paper-50);
  --color-brand-100: var(--paper-100);
  --color-brand-200: var(--paper-200);
  --color-brand-300: var(--paper-300);
  --color-brand-400: var(--brand-accent);
  --color-brand-500: var(--paper-500);
  --color-brand-600: var(--brand-accent);
  --color-brand-700: var(--ink-700);
  --color-brand-800: var(--ink-800);
  --color-brand-900: var(--ink-900);
  --color-brand-950: var(--ink-900);

  --font-display: var(--font-display);
  --font-sans: var(--font-sans);
}

html {
  scrollbar-width: thin;
  scrollbar-color: var(--paper-400) transparent;
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-sans), system-ui, sans-serif;
  overflow-x: hidden;
}

::selection {
  background: var(--ink-900);
  color: var(--paper-100);
}

/* ---- type scale ----------------------------------------------------------
   Eight steps (design-rules.md §4), generated from scaleRatio 3.75.
   Big type only reads as big against a quiet floor: the supporting sizes are
   placed on a geometric run and deliberately not raised to meet the
   headline. */

.t-display {
  font-family: var(--font-display), system-ui, sans-serif;
  font-size: clamp(2.25rem, min(6vw, 10.2vmin), 4.219rem);
  font-weight: 300;
  line-height: 0.86;
  letter-spacing: -0.007em;
  overflow-wrap: break-word;
}

.t-h2 {
  font-family: var(--font-display), system-ui, sans-serif;
  font-size: clamp(1.875rem, 8vw, 3.326rem);
  font-weight: 300;
  line-height: 0.9;
  letter-spacing: -0.006em;
  overflow-wrap: break-word;
}

.t-h2-col {
  font-family: var(--font-display), system-ui, sans-serif;
  font-size: clamp(1.5rem, 4vw, 2.422rem);
  font-weight: 300;
  line-height: 0.95;
  letter-spacing: -0.006em;
  overflow-wrap: break-word;
}

.t-h3 {
  font-family: var(--font-display), system-ui, sans-serif;
  font-size: clamp(1.41rem, 2.2vw, 1.763rem);
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: -0.004em;
  overflow-wrap: break-word;
}

.t-lead {
  font-family: var(--font-sans), system-ui, sans-serif;
  font-size: clamp(1.125rem, 1.6vw, 1.39rem);
  font-weight: 400;
  line-height: 1.45;
  letter-spacing: 0;
}

.t-body {
  font-family: var(--font-sans), system-ui, sans-serif;
  font-size: clamp(1rem, 1.1vw, 1.125rem);
  font-weight: 400;
  line-height: 1.6;
  letter-spacing: 0;
}

.meta {
  font-family: var(--font-sans), system-ui, sans-serif;
  font-size: clamp(0.75rem, 0.9vw, 0.875rem);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.btn-label {
  font-family: var(--font-sans), system-ui, sans-serif;
  font-size: clamp(0.875rem, 1vw, 1rem);
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

/* The measure every running-text block is capped to. */
.measure {
  max-width: var(--measure);
}
"
`;


"/* Generated from design.json by the design stage — do not hand-edit.
   direction: quiet-luxury · seed: quiet-luxury-fixture
   Every value below is derived from the spec: the scale from scaleRatio
   5, the ramp from brandH 318 / brandC 0.04
   (dark, photo-led). design-rules.md §4 owns the eight steps;
   the numbers are quiet-luxury's. */

@import "tailwindcss";

:root {
  --brand-h: 318;
  --brand-c: 0.04;

  /* paper: dark, photo-led */
  --paper-50: oklch(0.22 calc(var(--brand-c) * 0.3) var(--brand-h));
  --paper-100: oklch(0.19 calc(var(--brand-c) * 0.345) var(--brand-h));
  --paper-200: oklch(0.16 calc(var(--brand-c) * 0.39) var(--brand-h));
  --paper-300: oklch(0.14 calc(var(--brand-c) * 0.435) var(--brand-h));
  --paper-400: oklch(0.12 calc(var(--brand-c) * 0.48) var(--brand-h));
  --paper-500: oklch(0.1 calc(var(--brand-c) * 0.525) var(--brand-h));

  /* ink */
  --ink-900: oklch(0.97 calc(var(--brand-c) * 0.35) var(--brand-h));
  --ink-800: oklch(0.93 calc(var(--brand-c) * 0.3) var(--brand-h));
  --ink-700: oklch(0.87 calc(var(--brand-c) * 0.24999999999999997) var(--brand-h));
  --ink-600: oklch(0.78 calc(var(--brand-c) * 0.19999999999999996) var(--brand-h));
  --ink-400: oklch(0.6 calc(var(--brand-c) * 0.14999999999999997) var(--brand-h));

  --background: var(--paper-100);
  --foreground: var(--ink-900);
  --brand-accent: var(--ink-700);

  --font-display: var(--font-display-face);
  --font-sans: var(--font-body-face);

  /* shape (§4.2) */
  --radius: 0rem;
  --rule-width: 0px;
  --rule-color: transparent;

  /* grid (§4.2), as tokens so an archetype never branches on the direction
     name. centered: a centred language and a left-flush one are the
     same markup with a different anchor. */
  --text-align: center;
  --align-items: center;
  /* How far a secondary column is pushed off the baseline grid. Zero unless
     the direction is asymmetric, which is the only one that offsets. */
  --offset-y: 0rem;

  /* rhythm, from grid.density (poster) */
  --section-y: 7rem;
  --section-y-lg: 11rem;
  /* line length < 80ch (design-rules.md §4) */
  --measure: 72ch;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-paper-50: var(--paper-50);
  --color-paper-100: var(--paper-100);
  --color-paper-200: var(--paper-200);
  --color-paper-300: var(--paper-300);
  --color-paper-400: var(--paper-400);
  --color-paper-500: var(--paper-500);
  --color-ink-900: var(--ink-900);
  --color-ink-800: var(--ink-800);
  --color-ink-700: var(--ink-700);
  --color-ink-600: var(--ink-600);
  --color-ink-400: var(--ink-400);
  --color-accent: var(--brand-accent);

  /* The template's own components and globals.css's shadcn mapping are still
     written against brand-*; without these aliases every one of them
     resolves to nothing the moment this file replaces tokens.css. */
  --color-brand-50: var(--paper-50);
  --color-brand-100: var(--paper-100);
  --color-brand-200: var(--paper-200);
  --color-brand-300: var(--paper-300);
  --color-brand-400: var(--brand-accent);
  --color-brand-500: var(--paper-500);
  --color-brand-600: var(--brand-accent);
  --color-brand-700: var(--ink-700);
  --color-brand-800: var(--ink-800);
  --color-brand-900: var(--ink-900);
  --color-brand-950: var(--ink-900);


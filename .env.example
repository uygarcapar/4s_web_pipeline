# ============================================================================
# 4s_web_pipeline — environment variables
# Copy to .env and fill in. NEVER commit .env. All variables documented below.
# Secrets are scoped: the orchestrator passes each stage only the variables it
# needs (see docs/plan.md — Agent SDK `env` option / in-process tools).
# ============================================================================

# ----------------------------------------------------------------------------
# Anthropic (LLM stages: plan, generate, fix loop, design-judge, lead mini-report)
# Create a dedicated "Claude Code" workspace in the Anthropic Console with
# spend limits. Required from Milestone 3 onward.
# https://platform.claude.com/
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Vercel — OPTIONAL (docs/DECISIONS.md D1): deploys are manual-only via
# `pipeline deploy <domain>`; the automatic chain finishes locally. Leave
# empty until you decide to deploy a site. Pro plan is required once a
# deploy is commercial work.
# Token: https://vercel.com/account/tokens (scope it to the team).
# VERCEL_ORG_ID: team id (team_xxx) — the "scope" for CLI/REST calls.
# VERCEL_PROJECT_ID is NOT set here: it is created per-client via REST
# (POST /v11/projects) and stored in runs/<domain>/deploy/project.json.
# ----------------------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_ORG_ID=

# ----------------------------------------------------------------------------
# Google (discover stage + audit second opinion)
# Places API (New) Text Search — lead discovery (Ek A). Enterprise tier
# ~$35/1K requests, first 1,000/month free. Restrict the key to Places API.
# PageSpeed Insights API — free, 25k/day; used for candidate scoring and as
# an independent Lighthouse second opinion. Can be the same key if both APIs
# are enabled on it; kept separate so quotas/restrictions can differ.
# Maps Embed API key is used client-side in generated sites (map section);
# free with unlimited requests. Restrict by HTTP referrer.
# Required from Milestone 2 (PSI, optional) / Milestone 4 (Places) onward.
# ----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_PSI_API_KEY=
GOOGLE_MAPS_EMBED_API_KEY=

# ----------------------------------------------------------------------------
# Notification channel selection (docs/DECISIONS.md D3)
# "telegram" until the operator's company is registered and Meta business
# verification passes; then "whatsapp".
# ----------------------------------------------------------------------------
NOTIFY_CHANNEL=telegram

# Per-stage progress messages to the operator while a run is in flight
# ("tarama bitti", "site üretiliyor", ...). Set to `off` to keep only the
# single end-of-run "site is ready" notification. Default: on.
NOTIFY_PROGRESS=on

# ----------------------------------------------------------------------------
# Telegram (interim notification channel; docs/DECISIONS.md D3)
# Create the bot with @BotFather → token. Get your chat id by messaging the
# bot once and calling https://api.telegram.org/bot<token>/getUpdates
# Required from Milestone 2 (notify stage) onward.
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----------------------------------------------------------------------------
# WhatsApp — Meta Cloud API (target channel once business verification
# passes; docs/DECISIONS.md D2/D3). OPTIONAL until then — the operator's
# test WABA is restricted pending verification with company documents.
# Setup: Meta app (type Business) + WhatsApp product. The free TEST number
# can message up to 5 verified recipients — enough for operator notifications.
#   WA_TOKEN           permanent System User token (Business Settings →
#                      System Users → Generate Token; permissions:
#                      whatsapp_business_messaging, whatsapp_business_management)
#   WA_PHONE_NUMBER_ID from the app's WhatsApp → API Setup page (NOT the
#                      phone number itself)
#   OPERATOR_WHATSAPP  your own number in E.164, e.g. +905XXXXXXXXX, added
#                      and SMS-verified as a recipient on the API Setup page
#   WA_WABA_ID         optional: WhatsApp Business Account id, used to check
#                      template approval status via API
# Unattended delivery needs the approved Turkish "site_ready" utility
# template; until approval, free-form messages work only while your 24h
# session window is open (message the test number once to open it).
# ----------------------------------------------------------------------------
WA_TOKEN=
WA_PHONE_NUMBER_ID=
OPERATOR_WHATSAPP=
WA_WABA_ID=

# ----------------------------------------------------------------------------
# Generated client sites (set per-deploy by the deploy stage, documented here)
# SITE_PREVIEW=1 → X-Robots-Tag noindex, robots disallow, Basic-Auth in
# proxy.ts and a visible "Taslak / Önizleme" banner. Removed after sale.
# ----------------------------------------------------------------------------
SITE_PREVIEW=1
SITE_PREVIEW_USER=demo
SITE_PREVIEW_PASSWORD=

# ----------------------------------------------------------------------------
# Admin panel (apps/admin) — single user auth (Ek C). Runs on the VPS next to
# the orchestrator, never deployed to Vercel.
# ----------------------------------------------------------------------------
ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# Pipeline tuning (safe defaults, override as needed)
# ----------------------------------------------------------------------------
PIPELINE_MAX_BUDGET_USD_PER_SITE=10
PIPELINE_MAX_FIX_ITERATIONS=3
PIPELINE_CONCURRENCY=1
# Contact e-mail embedded in the crawler User-Agent (robots.txt politeness)
CRAWLER_CONTACT_EMAIL=

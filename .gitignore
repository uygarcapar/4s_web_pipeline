# Dependencies
node_modules/
.pnpm-store/

# Environment — never commit secrets
.env
.env.local
.env.*.local

# Build outputs
dist/
.next/
out/
*.tsbuildinfo

# Runtime data (the CLI can be invoked from any workspace dir, so match any depth)
# `data/*` rather than `data/`: git never descends into an ignored directory,
# so a `!data/corpus/` exception is unreachable under the broader pattern.
data/*
# The measured reference corpus IS committed — the design stage and the judge
# read it, and it is harvested on the operator's command, reviewed, and
# versioned, never regenerated per run (docs/DECISIONS.md D9).
#
# Measurements only. `shots/` is 5.2 MB of PNGs and every re-harvest would add
# another binary layer to the history; the few screenshots a direction needs
# as its reference set are copied into data/directions/<id>/refs/ instead
# (D10 §4.1) and committed there.
!data/corpus/
data/corpus/*
!data/corpus/measurements.json
!data/corpus/vocabulary.json
!data/directions/
# §8.3 calibration. `pairs.json` is 30 rows of numbers and is worth keeping —
# it is the evidence behind whatever the thresholds end up as. `shots/` is
# tens of MB of PNGs regenerated by one command, and `labels.json` is the
# operator's own judgement, exported from /calibrate when they are done.
!data/calibration/
data/calibration/shots/
# Self-hosted faces (D10 §13 Q2: free open-licence only). Vendored by
# apps/orchestrator/scripts/vendor-fonts.mjs, committed like the direction
# reference sets, and copied per run into the site's public/fonts/. Each
# family ships its OFL.txt, which OFL §2 requires to travel with the font.
!data/fonts/
runs/
leads/
.pipeline/

# Test / verify artifacts
.lighthouseci/
.reports/
playwright-report/
test-results/
coverage/
verify-digest.md
.playwright-mcp/
# Visual baselines are per-client and machine-specific: every generated site
# creates its own on first verify (--update-snapshots=missing).
*-snapshots/
.crawlee/

# Vercel
.vercel/

# OS / editor
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Dependencies
node_modules/
.pnpm-store/

# Environment — never commit secrets
.env
.env.local
.env.*.local

# Build outputs
dist/
.next/
out/
*.tsbuildinfo

# Runtime data (the CLI can be invoked from any workspace dir, so match any depth)
data/
runs/
leads/
.pipeline/

# Test / verify artifacts
.lighthouseci/
.reports/
playwright-report/
test-results/
coverage/
verify-digest.md
# Visual baselines are per-client and machine-specific: every generated site
# creates its own on first verify (--update-snapshots=missing).
*-snapshots/
.crawlee/

# Vercel
.vercel/

# OS / editor
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json
